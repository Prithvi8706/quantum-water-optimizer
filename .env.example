# Example environment configuration.
# Copy this file to ".env" and fill in your own values.
# The real ".env" file is git-ignored and must never be committed.

# D-Wave Leap API token (https://cloud.dwavesys.com/leap/)
DWAVE_API_TOKEN=your-dwave-token-here

# Optional: API host/port for the backend
API_HOST=0.0.0.0
API_PORT=8000
